{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "Fedora_small"
  },
  "display": {
    "separator": " ──> ",
    "color": {
      "keys": "blue",
      "title": "blue"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│ 󰣛 System"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages"
    },
    {
      "type": "de",
      "key": "│ 󱂬 Desktop"
    },
    {
      "type": "cpu",
      "key": "│ 󰻠 Processor"
    },
    {
      "type": "gpu",
      "key": "│ 󰍛 Graphics"
    },
    {
      "type": "memory",
      "key": "│ 󰑭 Memory"
    },
    {
      "type": "swap",
      "key": "│ 󰓡 Swap"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Storage"
    },
    {
      "type": "localip",
      "key": "│ 󰩟 Local IP",
      "format": "{ipv4} ({iface})"
    },
    {
      "type": "battery",
      "key": "│ 󰁹 Battery"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────╯"
    },
    "colors"
  ]
}
